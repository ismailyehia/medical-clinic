# Database (get these from Aiven dashboard)
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASS=your_aiven_password
DB_HOST=mysql-xxxxx.aiven.io
DB_PORT=12345
DB_DIALECT=mysql

# JWT Secret (use any random long string)
JWT_SECRET=your_super_secret_jwt_key_change_this

# Environment
NODE_ENV=production

# Frontend URL (for CORS, set after deploying frontend to Vercel)
CLIENT_URL=https://your-project.vercel.app
